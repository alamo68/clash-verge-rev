+
+// Abort is separate from Close so ordinary stream shutdown still drains gracefully.
+type resettableTCPConn struct {
+	*gonet.TCPConn
+	endpoint tcpip.Endpoint
+}
+
+func (c *resettableTCPConn) Abort() {
+	c.endpoint.Abort()
+}
+
+func (c *resettableTCPConn) Upstream() any {
+	return c.TCPConn
+}
+
+func (c *resettableTCPConn) ReaderReplaceable() bool { return true }
+func (c *resettableTCPConn) WriterReplaceable() bool { return true }
