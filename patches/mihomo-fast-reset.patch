+
+func resetConnection(w http.ResponseWriter, r *http.Request) {
+	c := statistic.DefaultManager.Get(chi.URLParam(r, "id"))
+	if c == nil {
+		render.Status(r, http.StatusGone)
+		render.JSON(w, r, render.M{"message": "selected connection is no longer active"})
+		return
+	}
+	resetter, ok := c.(interface{ Reset() error })
+	if !ok {
+		render.Status(r, http.StatusNotImplemented)
+		render.JSON(w, r, render.M{"message": statistic.ErrInboundResetUnsupported.Error()})
+		return
+	}
+	if err := resetter.Reset(); err != nil {
+		status := http.StatusInternalServerError
+		if errors.Is(err, statistic.ErrInboundResetUnsupported) {
+			status = http.StatusNotImplemented
+		}
+		render.Status(r, status)
+		render.JSON(w, r, render.M{"message": err.Error()})
+		return
+	}
+	w.Header().Set("X-Mihomo-Connection-Reset", "true")
+	render.NoContent(w, r)
+}
