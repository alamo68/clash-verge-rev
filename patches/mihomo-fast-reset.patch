diff --git a/hub/route/connections_reset_test.go b/hub/route/connections_reset_test.go
new file mode 100644
index 0000000..0697143
--- /dev/null
+++ b/hub/route/connections_reset_test.go
@@ -0,0 +1,69 @@
+package route
+
+import (
+	"net"
+	"testing"
+
+	"github.com/metacubex/http"
+	"github.com/metacubex/http/httptest"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/tunnel/statistic"
+)
+
+type resetRouteOutbound struct {
+	C.Conn
+	closed bool
+}
+
+func (c *resetRouteOutbound) Close() error              { c.closed = true; return nil }
+func (c *resetRouteOutbound) RemoteDestination() string { return "" }
+func (c *resetRouteOutbound) Chains() C.Chain           { return nil }
+func (c *resetRouteOutbound) ProviderChains() C.Chain   { return nil }
+
+type resetRouteInbound struct {
+	net.Conn
+	aborted bool
+}
+
+func (c *resetRouteInbound) Abort() { c.aborted = true }
+
+func TestResetConnectionAPIIsExplicitAndSelected(t *testing.T) {
+	outA, outB := &resetRouteOutbound{}, &resetRouteOutbound{}
+	inA, inB := &resetRouteInbound{}, &resetRouteInbound{}
+	a := statistic.NewTCPTracker(outA, inA, statistic.DefaultManager, &C.Metadata{}, nil, 0, 0, true)
+	b := statistic.NewTCPTracker(outB, inB, statistic.DefaultManager, &C.Metadata{}, nil, 0, 0, true)
+	t.Cleanup(func() { _ = a.Close(); _ = b.Close() })
+	router := connectionRouter()
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodDelete, "/"+a.ID()+"/reset", nil))
+	if response.Code != http.StatusNoContent || response.Header().Get("X-Mihomo-Connection-Reset") != "true" {
+		t.Fatalf("reset response: %d %s", response.Code, response.Body.String())
+	}
+	if !inA.aborted || !outA.closed || statistic.DefaultManager.Get(a.ID()) != nil {
+		t.Fatal("selected connection was not reset")
+	}
+	if inB.aborted || outB.closed || statistic.DefaultManager.Get(b.ID()) == nil {
+		t.Fatal("another connection was affected")
+	}
+	response = httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodDelete, "/"+a.ID()+"/reset", nil))
+	if response.Code != http.StatusGone {
+		t.Fatalf("missing connection must return410, got %d", response.Code)
+	}
+	response = httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodDelete, "/"+b.ID(), nil))
+	if response.Code != http.StatusNoContent || inB.aborted {
+		t.Fatal("ordinary DELETE gained reset semantics")
+	}
+}
+
+func TestResetConnectionAPIRejectsUnsupportedInbound(t *testing.T) {
+	outbound := &resetRouteOutbound{}
+	tracker := statistic.NewTCPTracker(outbound, nil, statistic.DefaultManager, &C.Metadata{}, nil, 0, 0, true)
+	t.Cleanup(func() { _ = tracker.Close() })
+	response := httptest.NewRecorder()
+	connectionRouter().ServeHTTP(response, httptest.NewRequest(http.MethodDelete, "/"+tracker.ID()+"/reset", nil))
+	if response.Code != http.StatusNotImplemented || outbound.closed {
+		t.Fatalf("unsupported reset changed connection: %d", response.Code)
+	}
+}
diff --git a/tunnel/statistic/tracker_reset_test.go b/tunnel/statistic/tracker_reset_test.go
new file mode 100644
index 0000000..f140060
--- /dev/null
+++ b/tunnel/statistic/tracker_reset_test.go
@@ -0,0 +1,123 @@
+package statistic
+
+import (
+	"errors"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/utils"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type resetTestOutbound struct {
+	C.Conn
+	aborted *bool
+	closed  bool
+}
+
+func (c *resetTestOutbound) Close() error {
+	if c.aborted != nil && !*c.aborted {
+		return errors.New("outbound closed before inbound reset")
+	}
+	c.closed = true
+	return nil
+}
+
+type resetTestInbound struct {
+	net.Conn
+	aborted bool
+}
+
+func (c *resetTestInbound) Abort() { c.aborted = true }
+
+func TestTrackerResetIsExplicitAndSelected(t *testing.T) {
+	manager := &Manager{}
+	inbound := &resetTestInbound{}
+	outbound := &resetTestOutbound{aborted: &inbound.aborted}
+	tracker := &tcpTracker{Conn: outbound, inbound: inbound, manager: manager, TrackerInfo: &TrackerInfo{UUID: utils.NewUUIDV4()}}
+	other := &tcpTracker{Conn: &resetTestOutbound{}, manager: manager, TrackerInfo: &TrackerInfo{UUID: utils.NewUUIDV4()}}
+	manager.Join(tracker)
+	manager.Join(other)
+	if err := tracker.Reset(); err != nil {
+		t.Fatal(err)
+	}
+	if !inbound.aborted || !outbound.closed || manager.Get(tracker.ID()) != nil {
+		t.Fatal("selected connection was not reset and released")
+	}
+	if manager.Get(other.ID()) != other {
+		t.Fatal("unselected connection was removed")
+	}
+	if err := tracker.Reset(); err != nil {
+		t.Fatal(err)
+	}
+	inbound.aborted = false
+	outbound.aborted = nil
+	if err := tracker.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if inbound.aborted {
+		t.Fatal("ordinary Close must not reset inbound")
+	}
+}
+
+func TestTrackerResetUnsupportedLeavesConnectionOpen(t *testing.T) {
+	manager := &Manager{}
+	outbound := &resetTestOutbound{}
+	tracker := &tcpTracker{Conn: outbound, manager: manager, TrackerInfo: &TrackerInfo{UUID: utils.NewUUIDV4()}}
+	manager.Join(tracker)
+	if err := tracker.Reset(); !errors.Is(err, ErrInboundResetUnsupported) {
+		t.Fatalf("unsupported reset returned %v", err)
+	}
+	if outbound.closed || manager.Get(tracker.ID()) != tracker {
+		t.Fatal("unsupported reset changed connection")
+	}
+}
+
+func TestTrackerResetSystemTUNDoesNotResetSharedProxySockets(t *testing.T) {
+	for _, typ := range []C.Type{C.TUN, C.HTTP} {
+		t.Run(typ.String(), func(t *testing.T) {
+			listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			client, err := net.DialTCP("tcp4", nil, listener.Addr().(*net.TCPAddr))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Close()
+			server, err := listener.AcceptTCP()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer server.Close()
+			manager := &Manager{}
+			outbound := &resetTestOutbound{}
+			tracker := &tcpTracker{Conn: outbound, inbound: server, manager: manager, TrackerInfo: &TrackerInfo{UUID: utils.NewUUIDV4(), Metadata: &C.Metadata{Type: typ}}}
+			manager.Join(tracker)
+			err = tracker.Reset()
+			_ = client.SetReadDeadline(time.Now().Add(time.Second))
+			var data [1]byte
+			if typ == C.HTTP {
+				if !errors.Is(err, ErrInboundResetUnsupported) || outbound.closed {
+					t.Fatal("proxy transport reset was not refused")
+				}
+				if _, err = server.Write([]byte{42}); err != nil {
+					t.Fatal(err)
+				}
+				if _, err = client.Read(data[:]); err != nil || data[0] != 42 {
+					t.Fatalf("proxy transport was affected: %v", err)
+				}
+				return
+			}
+			if err != nil || !outbound.closed {
+				t.Fatalf("System TUN reset failed: %v", err)
+			}
+			if _, err = client.Read(data[:]); err == nil || !strings.Contains(err.Error(), "reset") {
+				t.Fatalf("System TUN did not deliver reset: %v", err)
+			}
+		})
+	}
+}
